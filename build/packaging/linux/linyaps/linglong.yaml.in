# 玲珑（linyaps）构建清单模板。
#
# 业务定位：
#   交给 ll-builder 的项目清单（linglong.yaml）。由 build/scripts/package-linyaps.sh
#   渲染到暂存目录后使用，仓库里不保留已渲染产物（版本号每次发布都会变）。
#
# 为什么是「装配」而不是「编译」：
#   玲珑 base 镜像只有运行时，不含 gcc/pkg-config/GTK 开发头文件，也没有 Flutter SDK，
#   因此 Flutter 产物必须由 build-linux-bundle.sh 在发布容器里预先编译好，
#   本清单的 build 步骤只负责把预编译产物装配进 $PREFIX。
#
# 字段说明：
#   - package.id 必须是反向域名格式，且与容器内数据目录、desktop 文件名保持一致，
#     统一来自 config/application_identity.conf，禁止在本文件里另写一份。
#   - package.version 必须是四段式数字（MAJOR.MINOR.PATCH.REVISION）。
#   - command 用包内绝对路径：容器内没有 PATH 查找，裸命令名会启动失败。
#   - base 决定运行时提供的系统库（GTK3 等），Flutter Linux 产物依赖它。
version: "1"

package:
  id: @APPLICATION_ID@
  name: @PACKAGE_NAME@
  version: @LINGLONG_VERSION@
  kind: app
  description: |
    @PACKAGE_DESCRIPTION@

command:
  - @PREFIX@/linglong_store

base: @BASE_REF@

build: |
  bash /project/build.sh
